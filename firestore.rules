rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidUsername(username) {
      return username is string
        && username.size() >= 3
        && username.size() <= 30
        && username.matches('^[a-zA-Z0-9_\\.]+$');
    }

    function isPartnerMember(sessionId) {
      return isSignedIn()
        && (
          get(/databases/$(database)/documents/partnerSessions/$(sessionId)).data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/partnerSessions/$(sessionId)).data.partnerUid == request.auth.uid
        );
    }

    // Baby name catalog — public read; signed-in can create/update (Console or app bootstrap)
    match /baby_names/{nameId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // App stats (e.g. namesCount)
    match /meta/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // App update gate — readable on splash before login. Writes via Console only.
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile
    match /users/{uid} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll(['email', 'username', 'createdAt'])
        && request.resource.data.email is string
        && isValidUsername(request.resource.data.username);

      // Allow email fill-in when upgrading anonymous/guest (empty email) → real account
      allow update: if isOwner(uid)
        && (
          request.resource.data.email == resource.data.email
          || (
            resource.data.get('email', '') == ''
            && request.resource.data.email is string
          )
          || (
            resource.data.get('isAnonymous', false) == true
            && request.resource.data.email is string
          )
        )
        && (
          !('username' in request.resource.data)
          || request.resource.data.username == resource.data.username
          || isValidUsername(request.resource.data.username)
        );

      allow delete: if false;

      // Per-user favorites (nameId refs only)
      match /favorites/{nameId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Username uniqueness map
    match /usernames/{usernameLower} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && usernameLower == request.resource.data.username.lower();

      allow update, delete: if false;
    }

    // Likes / dislikes — allow owner full access under their reaction tree
    match /reactions/{uid} {
      allow read, write: if isOwner(uid);

      match /likes/{nameId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.nameId == nameId;

        allow delete: if isOwner(uid);
      }

      match /dislikes/{nameId} {
        allow read: if isOwner(uid);

        allow create, update: if isOwner(uid)
          && request.resource.data.nameId == nameId;

        allow delete: if isOwner(uid);
      }
    }

    // Partner sessions (max 2 users; join via code in app logic)
    match /partnerSessions/{sessionId} {
      allow read: if isSignedIn()
        && (
          resource.data.ownerUid == request.auth.uid
          || resource.data.partnerUid == request.auth.uid
          // Allow reading by joinCode query for join flow (active sessions)
          || resource.data.status == 'active'
        );

      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.partnerUid == null
        && request.resource.data.status == 'active'
        && request.resource.data.joinCode is string;

      allow update: if isSignedIn()
        && (
          // Owner can close / refresh
          resource.data.ownerUid == request.auth.uid
          // Partner can claim empty partnerUid seat
          || (
            resource.data.partnerUid == null
            && request.resource.data.partnerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.joinCode == resource.data.joinCode
          )
          // Partner can leave (clear their uid)
          || (
            resource.data.partnerUid == request.auth.uid
            && request.resource.data.partnerUid == null
          )
        );

      allow delete: if false;

      match /favorites/{nameId} {
        allow read: if isPartnerMember(sessionId);
        allow create, update, delete: if isPartnerMember(sessionId);
      }
    }
  }
}
